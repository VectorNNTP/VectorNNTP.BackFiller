{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectornntp.local/protocols/rabbitmq-article-work-response.v1.schema.json",
  "title": "BackFiller RabbitMQ Article-Work Response v1",
  "description": "Canonical application-level wire contract for BackFiller article retrieval responses carried in RabbitMQ RPC payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "requestId",
    "messageId",
    "backbone",
    "outcome"
  ],
  "$defs": {
    "concreteRequestId": {
      "type": "string",
      "format": "uuid",
      "minLength": 1,
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$).+"
    }
  },
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Application-level protocol version identifier."
    },
    "requestId": {
      "oneOf": [
        {
          "$ref": "#/$defs/concreteRequestId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Application request identity copied from request JSON payload when available; null indicates identity was unavailable during InvalidRequest parsing."
    },
    "messageId": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "Canonical NNTP Message-ID copied from request JSON payload when available; null indicates identity was unavailable during InvalidRequest parsing."
    },
    "backbone": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "Backbone identity copied from request JSON payload when available; null indicates identity was unavailable during InvalidRequest parsing."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "Success",
        "ArticleNotFound",
        "InvalidArticle",
        "InvalidRequest"
      ],
      "description": "Terminal response outcome emitted to NNRPD."
    },
    "uri": {
      "type": "string",
      "pattern": "^cache://(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?:(?:6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3})/[0-9a-f]{32}$",
      "description": "Success-only canonical article cache URI in the form cache://{CanonicalBackFillerFqdn}:{BindPort}/{MessageIdMd5}, where CanonicalBackFillerFqdn is a DNS hostname and MessageIdMd5 is the 32-character lowercase hexadecimal MD5 digest of the ASCII bytes of the exact messageId string."
    },
    "error": {
      "type": "string",
      "minLength": 1,
      "description": "Terminal failure detail for non-success terminal outcomes."
    }
  },
  "oneOf": [
    {
      "required": [
        "version",
        "requestId",
        "messageId",
        "backbone",
        "outcome",
        "uri"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "Success"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/concreteRequestId"
        },
        "messageId": {
          "type": "string",
          "minLength": 1
        },
        "backbone": {
          "type": "string",
          "minLength": 1
        }
      },
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "required": [
        "version",
        "requestId",
        "messageId",
        "backbone",
        "outcome",
        "error"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "ArticleNotFound"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/concreteRequestId"
        },
        "messageId": {
          "type": "string",
          "minLength": 1
        },
        "backbone": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      },
      "not": {
        "required": [
          "uri"
        ]
      }
    },
    {
      "required": [
        "version",
        "requestId",
        "messageId",
        "backbone",
        "outcome",
        "error"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "InvalidArticle"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/concreteRequestId"
        },
        "messageId": {
          "type": "string",
          "minLength": 1
        },
        "backbone": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      },
      "not": {
        "required": [
          "uri"
        ]
      }
    },
    {
      "required": [
        "version",
        "requestId",
        "messageId",
        "backbone",
        "outcome",
        "error"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "InvalidRequest"
          ]
        },
        "requestId": {
          "oneOf": [
            {
              "$ref": "#/$defs/concreteRequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "messageId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "backbone": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      },
      "not": {
        "required": [
          "uri"
        ]
      }
    }
  ]
}
