# VectorNNTP.BackFiller systemd service unit template
#
# Install at:
#   /etc/systemd/system/vectornntp-backfiller.service
#
# Enable and start:
#   sudo systemctl daemon-reload
#   sudo systemctl enable vectornntp-backfiller.service
#   sudo systemctl start vectornntp-backfiller.service

[Unit]
Description=VectorNNTP BackFiller Service
Documentation=https://github.com/VectorNNTP/VectorNNTP.BackFiller
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=vectornntp
Group=vectornntp
WorkingDirectory=/opt/vectornntp-backfiller

# Self-contained single-file linux-x64 publish output:
#   /opt/vectornntp-backfiller/VectorNNTP.BackFiller
ExecStart=/opt/vectornntp-backfiller/VectorNNTP.BackFiller

Restart=on-failure
RestartPreventExitStatus=2 4 5
RestartSec=5s
StartLimitIntervalSec=300s
StartLimitBurst=5

# TimeoutStopSec must remain greater than BackFiller:Shutdown:GracePeriodSeconds,
# which drives HostOptions.ShutdownTimeout (validated range: 5..600 seconds).
TimeoutStartSec=30s
TimeoutStopSec=630s

Environment="DOTNET_ENVIRONMENT=Production"
EnvironmentFile=-/etc/vectornntp-backfiller/vectornntp-backfiller.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vectornntp-backfiller

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

# The service writes certificate and log artifacts under the working directory.
ReadWritePaths=/opt/vectornntp-backfiller/certs /opt/vectornntp-backfiller/logs

[Install]
WantedBy=multi-user.target
